# Sem as variáveis do Supabase, o app roda em MODO DEMONSTRAÇÃO (dados fictícios no navegador).
# Force a demo mesmo com chaves configuradas:
# NEXT_PUBLIC_DEMO=1

NEXT_PUBLIC_SITE_URL=https://conectabc.com.br

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (veja /admin/stripe-guia)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
